+def _sqlite_state_tmpfs_args(openclaw_user: str | None = None) -> list[str]:
+    """Keep the gateway's sqlite (WAL + shm) off host bind mounts.
+
+    On macOS, virtiofs cannot back WAL shared-memory coordination, so schema
+    written by one connection is invisible to others ("no such table"). A
+    nested tmpfs over the state/ subdir keeps sqlite on a native filesystem
+    while the rest of the state dir stays host-visible for artifact capture.
+    Opt out with SOMA_OPENCLAW_STATE_TMPFS=0 (e.g. on Linux hosts).
+    """
+    flag = os.getenv("SOMA_OPENCLAW_STATE_TMPFS", "").strip().lower()
+    if flag in {"0", "false", "no", "off"}:
+        return []
+    options = "rw,size=512m,mode=1777"
+    if openclaw_user:
+        match = re.fullmatch(r"(\d+)(?::(\d+))?", openclaw_user.strip())
+        if match:
+            options += f",uid={match.group(1)}"
+            if match.group(2):
+                options += f",gid={match.group(2)}"
+    return ["--tmpfs", f"{OPENCLAW_CONTAINER_STATE_DIR}/state:{options}"]
+
+
 def _cli_base_args(context: RuntimeExecutionContext, *, gateway_name: str) -> list[str]:
     state_dir = _state_dir(context)
