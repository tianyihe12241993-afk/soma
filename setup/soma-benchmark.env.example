# Copy to /Users/user/SOMA-benchmark/.env and fill LLM_API_KEY.
# (Real .env is git-ignored — NEVER commit the key.)
# NOTE: paths below assume macOS home /Users/user — adjust to the new machine's paths.

# LLM (OpenRouter, same model the SOMA platform uses by default)
LLM_API_KEY=<YOUR_OPENROUTER_KEY>          # sk-or-v1-...  use a fresh altascloud-blocked key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-coder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=soma-bench

# SOMA plugin (improved miner is injected as base_miner.py)
SOMA_OPENCLAW_PLUGIN_PATH=/Users/user/SOMA-plugin
SOMA_OPENCLAW_PLUGIN_REINSTALL_ON_RUN_START=true

# Compression-service build context (Dockerfile lives in the SOMA repo; harness auto-builds the image)
COMPACT_BENCH_COMPRESSION_SERVICE_CONTEXT=/Users/user/SOMA/sandbox_service/compression_service

# Benchmark runner
SOMA_BENCHMARK_OUTPUT_DIR=outputs/soma-bench-local
SOMA_BENCHMARK_WORKSPACE=docker
SOMA_BENCHMARK_MAX_ITERATIONS=100
SOMA_BENCHMARK_EXECUTE=false
