{
  "$comment": "SOMA-ops compaction-safe hooks. Fast, non-invasive: checkpoint on compaction, reload state on session start/resume/compact, guard protected files, audit tool use. Hooks NEVER decide strategy, auto-submit miners, or modify miner code.",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/user/SOMA/scripts/checkpoint_session.py --reason precompact",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/user/SOMA/scripts/context_for_claude.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/user/SOMA/.claude/hooks/protect_files.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 /Users/user/SOMA/.claude/hooks/audit_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
