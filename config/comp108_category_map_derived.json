  "_meta": {
    "purpose": "Derived comp-108 Easy/Medium/Hard category map (platform does not expose it). Reconciled from 3 independent solvers + validator re-optimization.",
    "model": "reported_C ~= simple unweighted mean of platform_score over the category-C tasks, shared partition across all 15 miners, with the 5 SCREENER tasks EXCLUDED from the means.",
    "winning_model": "screener-OUT (excluding screeners beats including them: 0.2121 vs 0.2344, and beats random-5-exclusion controls, so exclusion is real signal not an artifact)",
