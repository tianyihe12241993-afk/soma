# Copy to config/secrets.env (GIT-IGNORED) and fill in. NEVER commit the real file.
# secrets.env is on the protected list (protect_files.py blocks edits to it).

# OpenRouter keys per shipped miner slot (used only for balance checks / re-attach; NOT for eval here)
OPENROUTER_KEY_M9=""
OPENROUTER_KEY_M10=""
OPENROUTER_KEY_M11=""

# Optional: dashboard auth cookie if the board ever requires it
SOMA_DASHBOARD_COOKIE=""
# Note: detailed PER-RUN scores need NO key — collect_runs.py replays the public
# dashboard server action (getSweTaskRunsAction) anonymously. (The platform JSON API
# at .../api/public/frontend-key/... would need x-api-key, but we don't use it.)

# Bittensor wallet (coldkey password is NEVER stored here — entered interactively)
SOMA_WALLET_NAME="tony-miner"
